<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>English Detective</title>
<style>
:root{--ink:#29334d;--muted:#68738b;--purple:#7664c8;--pale:#f0ecff;--pink:#ffe6ed;--mint:#def6e8;--cream:#fffaf1}
*{box-sizing:border-box}body{margin:0;padding:18px;background:linear-gradient(135deg,#f3efff,#fff8ec,#eaf8f0);font-family:system-ui,sans-serif;color:var(--ink)}button{font:inherit;cursor:pointer;border:0;border-radius:14px;padding:12px 16px;font-weight:750}button:disabled{cursor:not-allowed;opacity:.7}.app{max-width:900px;margin:auto}.bar{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:16px;font-weight:850}.logo{display:inline-grid;place-items:center;background:var(--purple);color:white;border-radius:13px;width:40px;height:40px;margin-right:8px}.pill{background:#ffffffc9;border:1px solid #e9e4f3;border-radius:30px;padding:8px 12px;font-size:13px;color:var(--muted)}.panel{background:#ffffffed;border:1px solid white;border-radius:26px;padding:clamp(20px,4vw,38px);box-shadow:0 15px 45px #4b3b7612}.hero{text-align:center}.eyebrow{text-transform:uppercase;letter-spacing:2px;color:var(--purple);font-size:12px;font-weight:900}h1{font-size:clamp(32px,7vw,52px);line-height:1.05;margin:12px 0}h2{margin:8px 0;font-size:clamp(24px,5vw,34px)}p{line-height:1.6;color:var(--muted)}.hero p{max-width:550px;margin:0 auto 22px}.sticker{font-size:48px;background:#fff0bd;border-radius:25px;width:88px;height:88px;display:grid;place-items:center;margin:22px auto 12px}.primary{background:var(--purple);color:white;box-shadow:0 4px 0 #5c4bab}.secondary{background:var(--pale);color:#55459d}.head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:16px}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:13px;margin-top:18px}.tile{background:var(--cream);text-align:left;border:2px solid transparent;padding:20px;min-height:140px}.tile:nth-child(2){background:var(--pink)}.tile:nth-child(3){background:var(--mint)}.tile .emoji{font-size:34px;display:block;margin-bottom:8px}.tile strong{display:block;font-size:18px}.tile small{display:block;color:var(--muted);margin-top:5px}.card{border:1px solid #e9e4f3;border-radius:18px;padding:17px;background:var(--cream)}.card p{font-size:14px;margin:5px 0 12px}.casegrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px}.gamegrid{display:grid;grid-template-columns:1.1fr .9fr;gap:16px}.story,.question{border-radius:20px;padding:20px}.story{background:var(--cream)}.story p{color:var(--ink)}.question{background:#f7f4ff}.qtype{display:inline-block;background:#e9e3ff;color:#55459d;border-radius:30px;padding:6px 10px;font-size:11px;font-weight:900;letter-spacing:.7px;text-transform:uppercase;margin:8px 0 2px}.options{display:grid;gap:9px;margin-top:15px}.choice{background:white;border:1px solid #ded8f3;text-align:left;color:var(--ink);box-shadow:0 3px 0 #e7e1f5}.choice:disabled{cursor:default}.correct{background:var(--mint)!important;border-color:#9bd6b2!important}.wrong{background:var(--pink)!important;border-color:#f4a9b8!important}.feedback{padding:12px;border-radius:13px;margin-top:13px;font-weight:700}.good{background:var(--mint);color:#236646}.try{background:var(--pink);color:#8a3650}.vocab{display:flex;flex-wrap:wrap;gap:8px;margin:10px 0}.word{background:white;border:1px solid #e9e4f3;border-radius:11px;padding:9px;font-size:13px;min-width:100px}.word b{display:block;color:#55459d}.hidden{display:none!important}.progress{height:7px;background:#eee9f7;border-radius:9px;margin:8px 0 18px;overflow:hidden}.progress span{display:block;background:var(--purple);height:100%;width:0;transition:width .2s}.foot{text-align:center;font-size:12px;color:var(--muted);margin:18px}.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}.score-number{font-size:clamp(42px,9vw,64px);color:var(--purple);font-weight:950;margin:8px 0}.stats{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;max-width:520px;margin:22px auto}.stat{background:var(--cream);border:1px solid #eee7dc;border-radius:16px;padding:14px}.stat strong{display:block;font-size:23px;color:var(--purple)}.stat span{color:var(--muted);font-size:12px}.rank{background:var(--pale);border-radius:16px;padding:14px;max-width:520px;margin:0 auto 20px;font-weight:800}
@media(max-width:650px){body{padding:10px}.gamegrid{grid-template-columns:1fr}.head{align-items:flex-start;flex-direction:column}.bar{align-items:flex-start}.pill{text-align:right}}
</style>
</head>
<body>
<div class="app">
<header class="bar"><div><span class="logo">ð</span>English Detective</div><div class="pill" id="score">â­ Score: 0 / 120</div></header>
<section id="welcome" class="panel hero"><div class="eyebrow">Read â¢ Think â¢ Solve</div><div class="sticker">ðµï¸</div><h1>Welcome, Detective!</h1><p>Ready to solve a mystery? Read the clues carefully, answer two questions in every case, and learn new English words along the way.</p><button class="primary" onclick="locations()">Start investigating â</button><p style="font-size:13px;margin-top:18px">A reading-comprehension and vocabulary game for English learners</p></section>
<section id="locations" class="panel hidden"><div class="head"><div><div class="eyebrow">Your investigation</div><h2>Choose a location</h2><p>Every place has a mystery waiting to be solved.</p></div><button class="secondary" onclick="home()">â Home</button></div><div class="grid"><button class="tile" onclick="showCases('living')"><span class="emoji">ðï¸</span><strong>Living Room</strong><small>Everyday clues</small></button><button class="tile" onclick="showCases('garden')"><span class="emoji">ð³</span><strong>Garden</strong><small>Find what is hiding outside</small></button><button class="tile" onclick="showCases('bedroom')"><span class="emoji">ðï¸</span><strong>Bedroom</strong><small>Read a secret description</small></button></div></section>
<section id="cases" class="panel hidden"><div class="head"><div><div id="locLabel" class="eyebrow"></div><h2>Choose a case</h2><p>Each case has one reading question and one vocabulary question.</p></div><button class="secondary" onclick="locations()">â Locations</button></div><div id="caseGrid" class="casegrid"></div></section>
<section id="game" class="panel hidden"><div class="head"><div><div id="gameLoc" class="eyebrow"></div><h2 id="gameTitle"></h2></div></div><div class="progress"><span id="progress"></span></div><div class="gamegrid"><article class="story"><div id="gameEmoji" style="font-size:40px"></div><h3>Read the case</h3><p id="story"></p><p><b>Detective tip:</b> Look for details that help you answer the questions.</p></article><article class="question"><div class="eyebrow" id="questionCount">Question 1 of 2</div><div class="qtype" id="questionType">Reading Comprehension</div><h3 id="question"></h3><div id="options" class="options"></div><div id="feedback" class="hidden"></div><div id="vocabArea" class="hidden"><h3>â¨ New Vocabulary</h3><p>Words from this case:</p><div id="vocab" class="vocab"></div></div><div class="actions"><button id="next" class="primary hidden" onclick="continueGame()">Next question â</button></div></article></div></section>
<section id="finish" class="panel hero hidden"><div class="sticker">ð</div><div class="eyebrow">Investigation complete</div><h1>Great detective work!</h1><p id="finishText"></p><div class="score-number" id="finalScore">0 / 120</div><div class="eyebrow">Your final score</div><div class="stats"><div class="stat"><strong id="completedStat">12 / 12</strong><span>Questions completed</span></div><div class="stat"><strong id="firstTryStat">0 / 12</strong><span>Correct on first try</span></div></div><div class="rank" id="rankText">ð Detective rank</div><button class="primary" onclick="reset()">Play again â»</button><div class="actions" style="justify-content:center"><button class="secondary" onclick="locations()">Explore locations</button></div></section>
<div class="foot">English Detective Â· A student-designed English-learning game</div>
</div>
<script>
const data={
living:[
{id:'remote',emoji:'ðº',title:'The Missing Remote',short:'A remote control has disappeared.',story:'Mia watched TV last night and remembers putting the remote on the sofa. This morning, it is missing. Her little brother is eating snacks on the floor, and one cushion is slightly out of place.',questions:[{type:'Reading Comprehension',q:'Where should Mia look first?',opts:['Under the sofa cushion','In the refrigerator','In the bathroom'],a:0,fb:'Well done! The cushion is an important clue. Mia should look under it first.'},{type:'Vocabulary',q:'What does the word "cushion" mean?',opts:['A soft pillow on a sofa','A small table','A type of television'],a:0,fb:'Correct! A cushion is a soft pillow that people put on a sofa or chair.'}],v:[['Cushion','a soft pillow on a sofa'],['Put','to place something somewhere'],['Floor','the surface you walk on']]},
{id:'book',emoji:'ð',title:'The Lost Book',short:'A library book is missing.',story:'Leo was reading a library book in the living room. He remembers leaving it beside the blue armchair. There is no book on the coffee table, but a school bag is standing next to the chair.',questions:[{type:'Reading Comprehension',q:'Where is the best place to look first?',opts:['Beside the blue armchair','Inside the oven','Under the garden flowers'],a:0,fb:'Correct! Leo remembers leaving the book beside the blue armchair.'},{type:'Vocabulary',q:'What does the word "beside" mean?',opts:['Far away from','Next to','On top of'],a:1,fb:'That is right! "Beside" means next to something.'}],v:[['Beside','next to something'],['Remember','to keep something in your mind'],['Library','a place where people borrow books']]}
],
garden:[
{id:'toby',emoji:'ð¶',title:'Where Is Toby?',short:'A playful dog is hiding.',story:'Toby was playing in the garden. He likes resting under the big tree. He is not near the gate, and he is not beside the flower pots. His owner wants to find him.',questions:[{type:'Reading Comprehension',q:'Where is Toby most likely hiding?',opts:['Near the gate','Under the big tree','Beside the flower pots'],a:1,fb:'Great job! The clue says Toby likes resting under the big tree.'},{type:'Vocabulary',q:'What does the word "gate" mean?',opts:['A door in a fence','A garden tool','A kind of flower'],a:0,fb:'Exactly! A gate is an entrance or door in a fence.'}],v:[['Near','close to something'],['Gate','a door in a fence'],['Garden','an area outside where plants grow']]},
{id:'can',emoji:'ð¼',title:'The Missing Watering Can',short:'The plants need water.',story:'Nina watered the flowers this morning. She remembers placing the watering can next to the garden bench. The bench is under a tree. She checked beside the gate, but the can was not there.',questions:[{type:'Reading Comprehension',q:'Where should Nina check next?',opts:['Next to the garden bench','Inside the refrigerator','On top of the roof'],a:0,fb:'That is right! Nina remembers placing the watering can next to the bench.'},{type:'Vocabulary',q:'What is a "bench"?',opts:['A long seat','A type of plant','A container for water'],a:0,fb:'Correct! A bench is a long seat, often found in a garden or park.'}],v:[['Watering can','a container used to water plants'],['Bench','a long seat'],['Next to','beside something']]}
],
bedroom:[
{id:'message',emoji:'ð°ï¸',title:'The Secret Message',short:'A message describes an object.',story:'A note says: âI am small and round. You use me to tell the time. I am on the wall above the desk. Look behind me to find your next clue.â',questions:[{type:'Reading Comprehension',q:'What object is described in the message?',opts:['A clock','A mirror','A school bag'],a:0,fb:'Fantastic! You understood the description. The object is a clock.'},{type:'Vocabulary',q:'What does the word "round" mean?',opts:['Shaped like a circle','Very heavy','Full of water'],a:0,fb:'Well done! "Round" means shaped like a circle.'}],v:[['Round','shaped like a circle'],['Above','in a higher position'],['Behind','at the back of something']]},
{id:'pencil',emoji:'âï¸',title:'The Disappearing Pencil',short:'A pencil is missing from a desk.',story:'Ava was drawing at her desk. She put her yellow pencil beside her notebook before leaving the room. Now the pencil is not on the desk. Her notebook is still open, and her pencil case is on the chair.',questions:[{type:'Reading Comprehension',q:'Where should Ava look first?',opts:['Inside the pencil case','In the garden pond','Behind the refrigerator'],a:0,fb:'Good thinking! The pencil case is a reasonable place to check.'},{type:'Vocabulary',q:'What is a "notebook"?',opts:['A book with blank or lined pages','A small chair','A container for food'],a:0,fb:'Correct! A notebook is a book with blank or lined pages for writing.'}],v:[['Notebook','a book of blank or lined pages'],['Pencil case','a small container for pens and pencils'],['Open','not closed']]}
]};
const names={living:'Living Room',garden:'Garden',bedroom:'Bedroom'};
const TOTAL_QUESTIONS=12,MAX_SCORE=120;
let loc='',active=null,solved=new Set(),totalScore=0,firstTryCorrect=0,currentQuestion=0,attempts=0,questionDone=false;
function screen(id){['welcome','locations','cases','game','finish'].forEach(s=>document.getElementById(s).classList.toggle('hidden',s!==id));window.scrollTo({top:0,behavior:'smooth'});}
function home(){screen('welcome');}function locations(){screen('locations');}
function updateScore(){document.getElementById('score').textContent=`â­ Score: ${totalScore} / ${MAX_SCORE}`;}
function showCases(location){loc=location;document.getElementById('locLabel').textContent=names[location];const grid=document.getElementById('caseGrid');grid.innerHTML='';data[location].forEach(item=>{const card=document.createElement('div');card.className='card';const emoji=document.createElement('div');emoji.style.fontSize='30px';emoji.textContent=item.emoji;const title=document.createElement('h3');title.textContent=item.title+(solved.has(item.id)?' â':'');const desc=document.createElement('p');desc.textContent=item.short;const btn=document.createElement('button');btn.className=solved.has(item.id)?'secondary':'primary';btn.textContent=solved.has(item.id)?'Case completed â':'Open case â';btn.disabled=solved.has(item.id);btn.addEventListener('click',()=>startCase(location,item.id));card.append(emoji,title,desc,btn);grid.appendChild(card);});screen('cases');}
function startCase(location,id){loc=location;active=data[location].find(item=>item.id===id);currentQuestion=0;attempts=0;questionDone=false;document.getElementById('gameLoc').textContent=names[location];document.getElementById('gameTitle').textContent=active.title;document.getElementById('gameEmoji').textContent=active.emoji;document.getElementById('story').textContent=active.story;document.getElementById('vocabArea').classList.add('hidden');renderQuestion();screen('game');}
function renderQuestion(){const q=active.questions[currentQuestion];document.getElementById('questionCount').textContent=`Question ${currentQuestion+1} of 2`;document.getElementById('questionType').textContent=q.type;document.getElementById('question').textContent=q.q;document.getElementById('progress').style.width=`${currentQuestion*50}%`;const fb=document.getElementById('feedback');fb.className='hidden';fb.textContent='';const next=document.getElementById('next');next.classList.add('hidden');next.textContent=currentQuestion===0?'Next question â':'Finish case â';document.getElementById('vocabArea').classList.add('hidden');const options=document.getElementById('options');options.innerHTML='';q.opts.forEach((option,index)=>{const btn=document.createElement('button');btn.className='choice';btn.textContent=`${String.fromCharCode(65+index)}. ${option}`;btn.addEventListener('click',()=>answer(index,btn));options.appendChild(btn);});}
function answer(selected,button){if(questionDone)return;const q=active.questions[currentQuestion],fb=document.getElementById('feedback');if(selected===q.a){questionDone=true;const points=attempts===0?10:5;totalScore+=points;if(attempts===0)firstTryCorrect++;updateScore();document.querySelectorAll('.choice').forEach(b=>b.disabled=true);button.classList.add('correct');fb.className='feedback good';fb.textContent=`ð ${q.fb} You earned ${points} points!`;document.getElementById('progress').style.width=`${(currentQuestion+1)*50}%`;if(currentQuestion===1)showVocabulary();const next=document.getElementById('next');next.textContent=currentQuestion===0?'Next question â':'Finish case â';next.classList.remove('hidden');}else{attempts++;button.classList.add('wrong');fb.className='feedback try';fb.textContent='Not quite! Read the clues again and try once more.';setTimeout(()=>button.classList.remove('wrong'),650);}}
function showVocabulary(){const area=document.getElementById('vocab');area.innerHTML='';active.v.forEach(item=>{const word=document.createElement('div');word.className='word';const title=document.createElement('b');title.textContent=item[0];const meaning=document.createElement('span');meaning.textContent=item[1];word.append(title,meaning);area.appendChild(word);});document.getElementById('vocabArea').classList.remove('hidden');}
function continueGame(){if(currentQuestion===0){currentQuestion=1;attempts=0;questionDone=false;renderQuestion();return;}solved.add(active.id);const all=Object.values(data).flat();if(all.every(item=>solved.has(item.id)))finishGame();else showCases(loc);}
function finishGame(){document.getElementById('finishText').textContent='You solved all six cases! You practised reading for details and learned new vocabulary. Excellent work, Detective!';document.getElementById('finalScore').textContent=`${totalScore} / ${MAX_SCORE}`;document.getElementById('completedStat').textContent=`${TOTAL_QUESTIONS} / ${TOTAL_QUESTIONS}`;document.getElementById('firstTryStat').textContent=`${firstTryCorrect} / ${TOTAL_QUESTIONS}`;const percent=totalScore/MAX_SCORE*100;let rank='ð± Rising Detective â Keep practising!';if(percent>=90)rank='ð Master Detective â Outstanding work!';else if(percent>=75)rank='ð Super Detective â Great job!';else if(percent>=50)rank='ð Skilled Detective â Well done!';document.getElementById('rankText').textContent=rank;screen('finish');}
function reset(){solved.clear();totalScore=0;firstTryCorrect=0;active=null;currentQuestion=0;attempts=0;questionDone=false;updateScore();locations();}
updateScore();
</script>
</body>
</html>
